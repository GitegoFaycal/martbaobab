# PostgreSQL connection string (docker-compose default shown)
DATABASE_URL=postgresql://martbaobab:martbaobab@localhost:5432/martbaobab

# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API
CLIENT_URL=http://localhost:5173
# Optional regex for Vercel preview deployments, e.g. ^https://martbaobab-[a-z0-9-]+\.vercel\.app$
VERCEL_PREVIEW_PATTERN=

# Authentication
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Password-reset email (required in production; logged to the console in development when empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=MartBaobab
SMTP_FROM_EMAIL=

# First administrator account, used by `npm run db:seed`
ADMIN_NAME=MartBaobab Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
