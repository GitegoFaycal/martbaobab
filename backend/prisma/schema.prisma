generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SELLER
  DELIVERY
  ADMIN
}

enum ListingType {
  PRODUCT
  SERVICE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(CUSTOMER)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shops     Shop[]
  orders    Order[]
  reviews   Review[]
  addresses Address[]
}

model Address {
  id        String   @id @default(cuid())
  label     String
  city      String
  district  String?
  sector    String?
  details   String?
  latitude  Float?
  longitude Float?
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Shop {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  coverUrl    String?
  phone       String?
  whatsapp    String?
  city        String
  verified    Boolean  @default(false)
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id])
  listings Listing[]
  orders   Order[]
}

model Category {
  id   String  @id @default(cuid())
  name String
  slug String  @unique
  icon String?

  listings Listing[]
}

model Listing {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  type        ListingType @default(PRODUCT)
  price       Decimal     @db.Decimal(12, 2)
  stock       Int?
  active      Boolean     @default(true)
  shopId      String
  categoryId  String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  shop       Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category   Category       @relation(fields: [categoryId], references: [id])
  images     ListingImage[]
  orderItems OrderItem[]
  reviews    Review[]
}

model ListingImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  position  Int     @default(0)
  listingId String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Order {
  id          String      @id @default(cuid())
  reference   String      @unique
  status      OrderStatus @default(PENDING)
  subtotal    Decimal     @db.Decimal(12, 2)
  deliveryFee Decimal     @default(0) @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)
  customerId  String
  shopId      String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customer User        @relation(fields: [customerId], references: [id])
  shop     Shop        @relation(fields: [shopId], references: [id])
  items    OrderItem[]
  payment  Payment?
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  orderId   String
  listingId String

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id])
}

model Payment {
  id        String        @id @default(cuid())
  provider  String
  reference String?
  status    PaymentStatus @default(PENDING)
  amount    Decimal       @db.Decimal(12, 2)
  orderId   String        @unique
  createdAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  authorId  String
  listingId String
  createdAt DateTime @default(now())

  author  User    @relation(fields: [authorId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([authorId, listingId])
}
