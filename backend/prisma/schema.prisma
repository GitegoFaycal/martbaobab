generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SELLER
  DELIVERY
  ADMIN
}

enum ListingType {
  PRODUCT
  SERVICE
}

enum ListingCondition {
  NEW
  USED
}

enum CategoryKind {
  GOODS
  SERVICES
  JOBS
}

enum JobType {
  DAILY
  CONTRACT
  PART_TIME
  FULL_TIME
}

enum PayPeriod {
  PER_DAY
  PER_WEEK
  PER_MONTH
  PER_TASK
}

enum JobStatus {
  OPEN
  CLOSED
  FILLED
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  ACCEPTED
  REJECTED
}

enum PaymentProvider {
  MTN_MOMO
  AIRTEL_MONEY
  CASH_ON_DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  phone               String?   @unique
  passwordHash        String
  role                Role      @default(CUSTOMER)
  avatarUrl           String?
  district            String?
  headline            String?
  bio                 String?
  skills              String[]  @default([])
  views               Int       @default(0)
  active              Boolean   @default(true)
  emailVerified       Boolean   @default(false)
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  shops        Shop[]
  orders       Order[]
  reviews      Review[]
  addresses    Address[]
  jobs         Job[]
  applications JobApplication[]
  connectionsAsSeller Connection[] @relation("ConnectionSeller")
  connectionsAsBuyer  Connection[] @relation("ConnectionBuyer")
}

model Address {
  id        String   @id @default(cuid())
  label     String
  city      String
  district  String?
  sector    String?
  details   String?
  latitude  Float?
  longitude Float?
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Shop {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  coverUrl    String?
  phone       String?
  whatsapp    String?
  city        String
  district    String?
  sector      String?
  address     String?
  verified    Boolean  @default(false)
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id])
  listings Listing[]
  orders   Order[]

  @@index([district])
}

model Category {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  icon        String?
  kind        CategoryKind @default(GOODS)
  description String?
  position    Int          @default(0)

  listings Listing[]
  jobs     Job[]
}

model Listing {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  description   String?
  type          ListingType      @default(PRODUCT)
  condition     ListingCondition @default(NEW)
  price         Decimal          @db.Decimal(12, 2)
  originalPrice Decimal?         @db.Decimal(12, 2)
  unit          String?
  negotiable    Boolean          @default(false)
  stock         Int?
  district      String?
  views         Int              @default(0)
  active        Boolean          @default(true)
  shopId        String
  categoryId    String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  shop       Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category   Category       @relation(fields: [categoryId], references: [id])
  images     ListingImage[]
  orderItems  OrderItem[]
  reviews     Review[]
  connections Connection[]

  @@index([condition, active])
  @@index([categoryId])
  @@index([district])
}

model ListingImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  position  Int     @default(0)
  listingId String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Job {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  description   String
  requirements  String?
  district      String
  sector        String?
  jobType       JobType   @default(DAILY)
  payPeriod     PayPeriod @default(PER_DAY)
  payMin        Decimal?  @db.Decimal(12, 2)
  payMax        Decimal?  @db.Decimal(12, 2)
  workersNeeded Int       @default(1)
  startDate     DateTime?
  durationText  String?
  contactPhone  String?
  status        JobStatus @default(OPEN)
  views         Int       @default(0)
  categoryId    String?
  employerId    String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  category     Category?        @relation(fields: [categoryId], references: [id])
  employer     User             @relation(fields: [employerId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([status, district])
  @@index([categoryId])
}

model JobApplication {
  id          String            @id @default(cuid())
  message     String?
  phone       String
  status      ApplicationStatus @default(PENDING)
  jobId       String
  applicantId String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant User @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([jobId, applicantId])
}

model Order {
  id               String      @id @default(cuid())
  reference        String      @unique
  status           OrderStatus @default(PENDING)
  subtotal         Decimal     @db.Decimal(12, 2)
  deliveryFee      Decimal     @default(0) @db.Decimal(12, 2)
  total            Decimal     @db.Decimal(12, 2)
  customerPhone    String?
  deliveryDistrict String?
  deliveryAddress  String?
  note             String?
  customerId       String
  shopId           String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  customer User        @relation(fields: [customerId], references: [id])
  shop     Shop        @relation(fields: [shopId], references: [id])
  items    OrderItem[]
  payment  Payment?

  @@index([customerId])
  @@index([shopId, status])
}

model OrderItem {
  id        String  @id @default(cuid())
  name      String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  orderId   String
  listingId String

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id])
}

model Payment {
  id        String          @id @default(cuid())
  provider  PaymentProvider @default(CASH_ON_DELIVERY)
  reference String?
  status    PaymentStatus   @default(PENDING)
  amount    Decimal         @db.Decimal(12, 2)
  orderId   String          @unique
  createdAt DateTime        @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

// A connection: a buyer reached out to a seller (WhatsApp or call) from a
// listing or a profile. This is the core metric of LOCO.
model Connection {
  id         String   @id @default(cuid())
  channel    String   @default("WHATSAPP")
  source     String   @default("LISTING")
  listingId  String?
  sellerId   String
  buyerId    String?
  visitorKey String?
  createdAt  DateTime @default(now())

  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  seller  User     @relation("ConnectionSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer   User?    @relation("ConnectionBuyer", fields: [buyerId], references: [id], onDelete: SetNull)

  @@index([sellerId, createdAt])
  @@index([listingId])
  @@index([buyerId])
}

// Uploaded photos. Stored in PostgreSQL when no object storage is
// configured; when BLOB_READ_WRITE_TOKEN is set, files go to Vercel Blob and
// only the metadata is kept here.
model Image {
  id        String   @id @default(cuid())
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  data      Bytes?
  url       String?
  ownerId   String?
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  authorId  String
  listingId String
  createdAt DateTime @default(now())

  author  User    @relation(fields: [authorId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([authorId, listingId])
}
